{
    "name": "spora-ai/spora-plugin-social-frontend",
    "private": true,
    "version": "0.1.0",
    "description": "Vue IIFE bundle for the Spora social publishing app. Built and shipped as type spora-plugin-frontend.",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "vue-tsc --noEmit && vite build",
        "preview": "vite preview",
        "lint": "eslint .",
        "typecheck": "vue-tsc --noEmit",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage",
        "i18n:extract": "node scripts/i18n.mjs",
        "i18n:check": "node scripts/i18n.mjs --check",
        "smoke": "node scripts/smoke.js",
        "clean": "node scripts/clean.js"
    },
    "dependencies": {
        "lucide-vue-next": "^0.487.0",
        "pinia": "^2.3.0",
        "vue": "^3.5.0",
        "vue-i18n": "^11.4.16",
        "vue-router": "^4.5.0"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@tailwindcss/vite": "^4.3.3",
        "@typescript-eslint/typescript-estree": "^8.59.1",
        "@vitejs/plugin-vue": "^5.2.0",
        "@vitest/coverage-v8": "^4.1.10",
        "@vue/test-utils": "^2.4.6",
        "eslint": "^10.3.0",
        "eslint-plugin-vue": "^10.9.0",
        "happy-dom": "^21.0.4",
        "tailwindcss": "^4.3.3",
        "typescript": "^5.7.0",
        "typescript-eslint": "^8.59.1",
        "vite": "^6.0.0",
        "vitest": "^4.1.2",
        "vue-eslint-parser": "^10.4.0",
        "vue-tsc": "^2.2.0"
    }
}
